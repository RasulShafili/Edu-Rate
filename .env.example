# Kanonik frontend ünvanı və CSRF origin allowlist-i.
NEXT_PUBLIC_SITE_URL=https://edu-rate-nu.vercel.app
EDURATE_APP_ORIGIN=https://edu-rate-nu.vercel.app

# Xarici Express backend ünvanı. Boş olduqda EduRate Render API istifadə edilir.
# Brauzer sorğuları təhlükəsiz BFF üçün həmişə lokal /api altından keçir.
NEXT_PUBLIC_API_BASE_URL=
EDURATE_API_BASE_URL=

# Backend-in EDURATE_PROXY_SECRET-i ilə EYNİ dəyər (openssl rand -base64 48).
# Server tərəfində qalır, brauzerə getmir (NEXT_PUBLIC_ prefiksi yoxdur).
EDURATE_PROXY_SECRET=
