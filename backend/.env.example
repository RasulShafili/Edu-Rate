NODE_ENV=development
PORT=3001

# Production-da Render PostgreSQL bu dəyəri təmin edir.
DATABASE_URL=

# JWT imzalama açarı — BÜTÜN mühitlərdə məcburidir (development daxil).
# Verilməsə və ya 32 simvoldan qısa olsa server ümumiyyətlə başlamır.
# Aşağıdakı dəyər yalnız lokal iş üçün nümunədir və git-də olduğu üçün
# ICTIMAI sayılır — deploy edilən heç bir mühitdə istifadə etmə.
# Öz açarını yarat:
#   openssl rand -base64 48
JWT_SECRET=vS7f5fxRqdlGnfHYDeuChleISsco1thPUhCnkpy626F0GAeHeGtHrpdwO4SngPrz
JWT_EXPIRES_IN=30d

# Birdən çox ünvanı vergüllə ayırmaq mümkündür.
FRONTEND_URL=http://localhost:3000,https://edu-rate-nu.vercel.app

# Əsas admin rolu veriləcək e-poçtlar (vergüllə ayrılır).
# Admin köməkçisini bu hesablardan biri Admin panelində `assistant_admin` rolu ilə təyin edir.

# Render proxy arxasında işlədiyi üçün production-da true olmalıdır.
TRUST_PROXY=false

# Frontend BFF ilə ortaq sirr (frontend-in EDURATE_PROXY_SECRET-i ilə eyni).
# BFF istifadəçinin real IP-sini bununla göndərir; olmasa giriş və qeydiyyat
# limitləri Vercel arxasında bütün istifadəçilər üçün ortaq olur.
#   openssl rand -base64 48
EDURATE_PROXY_SECRET=
SEED_DEMO_DATA=false

# E-poçt təsdiqi və şifrə bərpası. Açar yoxdursa lokal mühitdə hesab dərhal təsdiqlənir.
RESEND_API_KEY=
# Domen yoxdursa Brevo-da təsdiqlənmiş göndərən ünvanı və BREVO_API_KEY istifadə edin.
BREVO_API_KEY=
# Resend üçün təsdiqlənmiş domen, Brevo üçün isə təsdiqlənmiş sender ünvanı yazılmalıdır.
EMAIL_FROM=EduRate <noreply@your-verified-domain.az>
PUBLIC_APP_URL=https://edu-rate-nu.vercel.app

# Production API sənədlərini yalnız admin üçün qorumaq tövsiyə olunur.
SWAGGER_PUBLIC=false

# Təhlükəsiz şəkil yaddaşı. Preset signed olmalı, yalnız JPG/PNG/WebP qəbul
# etməli və maksimum fayl ölçüsü 5 MB olmalıdır.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=edurate-secure

# Web push (cihaz bildirişləri). Açarları bir dəfə yarat:
#   npx web-push generate-vapid-keys
# Açarlar verilməsə push tamamilə passiv qalır və sayt normal işləyir.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@edurate.az
